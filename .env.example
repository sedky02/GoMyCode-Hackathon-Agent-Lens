# Copy to .env (same folder) and fill in. Leave BASE_URL or MODEL empty to run rules-only.

# Your Brev API key (sent as "Authorization: Bearer <key>")
AGENTLENS_LLM_API_KEY=
# The endpoint URL from the Brev console, ending in /v1 (everything before /chat/completions)
AGENTLENS_LLM_BASE_URL=
# Exact model id. Find it with:  .venv/bin/python -m agentlens.judge --check
AGENTLENS_LLM_MODEL=

# rules | hybrid | llm   (hybrid = judge only uncertain sessions; llm = judge every session)
AGENTLENS_MODE=llm
