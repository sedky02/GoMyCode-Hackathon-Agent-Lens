# Optional. Copy to .env to enable the LLM judge; without it AgentLens runs rules-only.
# Any OpenAI-compatible endpoint works (vLLM, NIM, Ollama, a hosted API).

# Endpoint URL ending in /v1 (everything before /chat/completions)
AGENTLENS_LLM_BASE_URL=
# Exact model id. List the ids your key can use with:  .venv/bin/python -m agentlens.judge --check
AGENTLENS_LLM_MODEL=
# Sent as "Authorization: Bearer <key>". Leave empty for endpoints without auth.
AGENTLENS_LLM_API_KEY=

# rules | hybrid | llm   (hybrid = judge only sessions the rules are unsure about; llm = judge every session)
AGENTLENS_MODE=hybrid
